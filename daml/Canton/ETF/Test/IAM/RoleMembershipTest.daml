module Canton.ETF.Test.IAM.RoleMembershipTest where

import Canton.ETF.IAM.RoleMembership
import DA.Assert
import Daml.Script
import DA.Time (time)
import DA.Date (date, Month(..))

data Parties = Parties
    with
        operator : Party
        alice    : Party
        bob      : Party
        intruder : Party

setupParties : Script Parties
setupParties = do
    operator <- allocateParty "Operator"
    alice <- allocateParty "Alice"
    bob <-allocateParty "Bob"
    intruder <- allocateParty "Intruder"
    return Parties{..}

baseTime : Time
baseTime = time (date 2025 Jan 1) 0 0 0

makeGrant : Party -> Party -> Text -> Script (ContractId RoleMembership)
makeGrant operator grantee role =
    submit operator do
        createCmd RoleMembership with
            operator
            grantee
            role
            grantedAt = baseTime

testGrantFundManager : Script ()
testGrantFundManager = do
    p <- setupParties
    cid <- makeGrant p.operator p.alice "FundManager"
    Some entry <- queryContractId p.operator cid
    entry.role === "FundManager"

testRevoke : Script()
testRevoke = do
    p <- setupParties
    cid <- makeGrant p.operator p.alice "MarketMaker"
    Some entry <- queryContractId p.operator cid
    entry.role === "MarketMaker"

    submit p.operator do
        exerciseCmd cid Revoke
    result <- queryContractId p.operator cid
    result === None

testInvalidRole_fails : Script()
testInvalidRole_fails = do
    p <- setupParties
    submitMustFail p.operator do
        createCmd RoleMembership with
            operator = p.operator
            grantee = p.alice
            role = "CBR"
            grantedAt = baseTime

testRevoke_nonOperator_fails : Script ()
testRevoke_nonOperator_fails = do
    p <- setupParties
    cid <- makeGrant p.operator p.alice "MarketMaker"
    Some entry <- queryContractId p.operator cid

    submitMustFail p.bob do
        exerciseCmd cid Revoke
    
testTransferOperator : Script ()
testTransferOperator = do
    p <- setupParties
    cid <- makeGrant p.operator p.alice "MarketMaker"
    Some entry <- queryContractId p.operator cid

    cid2 <- submit [p.operator, p.bob] do
        exerciseCmd cid TransferOperator with newOperator = p.bob

    Some otherEntry <- queryContractId p.bob cid2
    otherEntry.operator === p.bob


