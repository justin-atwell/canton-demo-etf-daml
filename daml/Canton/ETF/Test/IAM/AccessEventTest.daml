module Canton.ETF.Test.IAM.AccessEventTest where

import DA.Assert
import Daml.Script
import Canton.ETF.IAM.AccessEvent
import DA.Time (time)
import DA.Date (date, Month(..))

data Parties = Parties
    with
        operator : Party
        actor : Party
        auditor : Party

setupParties : Script Parties
setupParties = do
    operator <- allocateParty "Operator"
    actor <- allocateParty "Actor"
    auditor <- allocateParty "Auditor"
    return Parties{..}

baseTime : Time
baseTime = time (date 2026 Jan 1) 0 0 0

makeEvent : Party -> Party -> Party -> Text -> Text -> Bool -> Script (ContractId AccessEvent)
makeEvent operator actor auditor action resource granted = 
    submit operator do
        createCmd AccessEvent with
            operator
            actor
            auditor
            action
            resource
            timestamp = baseTime
            granted
            clientIp = "1.1.1.1"
            sessionId = ""

testAccessEvent : Script ()
testAccessEvent = do
    p <- setupParties
    cid <- makeEvent p.operator p.actor p.auditor "add permissions" "ETF/SPY" True
    Some entry <- queryContractId p.operator cid
    entry.action === "add permissions"
    entry.resource === "ETF/SPY"
    entry.clientIp === "1.1.1.1"
    entry.granted === True

testEmptyActionFails : Script ()
testEmptyActionFails = do
    p <- setupParties
    submitMustFail p.operator do
        createCmd AccessEvent with
            operator = p.operator
            actor = p.actor
            auditor = p.auditor
            action = ""
            resource = "ETF/SPY"
            timestamp = baseTime
            granted = True
            clientIp = "1.1.1.1"
            sessionId = ""

testEmptyResourceFials : Script ()
testEmptyResourceFials = do
    p <- setupParties
    submitMustFail p.operator do
        createCmd AccessEvent with
            operator = p.operator
            actor = p.actor
            auditor = p.auditor
            action = "add permisions"
            resource = ""
            timestamp = baseTime
            granted = True
            clientIp = "1.1.1.1"
            sessionId = ""

