module Canton.ETF.Test.Fund.CapTableTest where

import Canton.ETF.Fund.CapTable
import DA.Assert
import Daml.Script

data Parties = Parties
    with
        fundManager : Party
        custodian : Party
        recipient : Party
        holder : Party

setupParties : Script Parties
setupParties = do
    fundManager <- allocateParty "FundManager"
    custodian <- allocateParty "Custodian"
    recipient <- allocateParty "Recipient"
    holder <- allocateParty "Holder"
    return Parties{..}

makeCapTable : Party -> Party -> Script (ContractId CapTable)
makeCapTable fundManager custodian =
    submit [fundManager, custodian] do
        createCmd CapTable with
            fundManager
            custodian
            ticker = "SPY"
            totalShares = 0.0
            entries = []

testCreate : Script ()
testCreate = do
    p <- setupParties
    cid <- makeCapTable p.fundManager p.custodian
    Some entry <- queryContractId p.fundManager cid

    entry.ticker === "SPY"
    entry.totalShares === 0.0

testIssueShares : Script ()
testIssueShares = do
    p <- setupParties
    cid <- makeCapTable p.fundManager p.custodian
    Some entry <- queryContractId p.fundManager cid

    cid2 <- submit p.custodian do
        exerciseCmd cid IssueShares with
            recipient = p.recipient
            amount = 100.0

    Some otherEntry <- queryContractId p.fundManager cid2
    otherEntry.totalShares === 100.0
    otherEntry.entries === [(p.recipient, 100.0)]

testRedeemShares : Script ()
testRedeemShares = do
    p <- setupParties
    cid <- makeCapTable p.fundManager p.custodian
    Some entry <- queryContractId p.fundManager cid

    cid2 <- submit p.custodian do
        exerciseCmd cid IssueShares with
            recipient = p.recipient
            amount = 100.0

    cid3 <- submit p.custodian do
        exerciseCmd cid2 RedeemShares with
            recipient = p.recipient
            amount = 100.0
    
    Some otherEntry <- queryContractId p.fundManager cid3
    otherEntry.totalShares === 0.0
    otherEntry.entries === []
