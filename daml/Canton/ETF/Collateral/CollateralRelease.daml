module Canton.ETF.Collateral.CollateralRelease where

template CollateralRelease
    with
        custodian : Party
        fundManager : Party
        compliance : Party
        auditor : Party
        asset : Text
        amount : Decimal
        reason : Text
        releasedAt : Time
    where
        signatory custodian
        observer fundManager, compliance, auditor

        ensure
            asset /= ""
            && amount > (0.0)